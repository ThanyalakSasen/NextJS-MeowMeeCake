# คัดลอกเป็น .env.local แล้วใส่ค่าจริง (.env.local ถูก .gitignore ไว้)

# ── จำเป็นต่อ backend ปัจจุบัน ─────────────────────────────
# MongoDB connection string (ใช้ใน src/lib/dbConnect.ts)
MONGODB_URI=mongodb://127.0.0.1:27017/meowmeecake

# ระดับ log ต่ำสุดที่จะแสดง (debug|info|warn|error) — ใช้ใน src/lib/logger.ts
# ไม่ตั้ง = production:"info" / อื่น ๆ:"debug"
LOG_LEVEL=

# ── ชั้น auth ─────────────────────────────────────────────
JWT_SECRET=replace-with-long-random-string
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# ── CORS (frontend แยก origin — src/lib/cors.ts) ────────────
# comma-separated list ของ origin ที่อนุญาตให้ยิง API ข้าม origin มาได้ (คู่กับ credentials)
# ไม่ตั้ง/ว่าง = ปิดทั้งหมด (สมมติ same-origin เหมือนเดิม)
# backend เองใช้ port 3000 (default) → frontend ต้องรันคนละ port เช่น 3001
ALLOWED_ORIGINS=http://localhost:3001

# ── Google login (ID-token flow — Google Identity Services ฝั่ง frontend) ──
# frontend โหลด https://accounts.google.com/gsi/client แล้วส่ง credential (ID token)
# มาที่ POST /api/auth/google · server ตรวจ signature (JWKS) + iss + aud + exp
# ต้องใช้แค่ CLIENT_ID · ไม่มี redirect/code flow → ไม่ต้องใช้ CLIENT_SECRET / CALLBACK_URL
GOOGLE_CLIENT_ID=

# ── อีเมล (ยืนยันอีเมล / reset password) ───────────────────
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=

# ── LINE Messaging API (แจ้งเตือน — ทำภายหลัง) ─────────────
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_ID=
