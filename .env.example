# คัดลอกเป็น .env.local แล้วใส่ค่าจริง (.env.local ถูก .gitignore ไว้)

# ── จำเป็นต่อ backend ปัจจุบัน ─────────────────────────────
# MongoDB connection string (ใช้ใน src/lib/dbConnect.ts)
MONGODB_URI=mongodb://127.0.0.1:27017/meowmeecake

# ระดับ log ต่ำสุดที่จะแสดง (debug|info|warn|error) — ใช้ใน src/lib/logger.ts
# ไม่ตั้ง = production:"info" / อื่น ๆ:"debug"
LOG_LEVEL=

# ── ชั้น auth ─────────────────────────────────────────────
JWT_SECRET=replace-with-long-random-string
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# ── next-auth (หน้าเว็บลูกค้า — src/lib/nextAuth.ts · docs/customer-backend-merge.md §8.9) ──
# ไม่ตั้ง NEXTAUTH_SECRET = middleware ไม่อ่าน session ของหน้าเว็บลูกค้า → ลูกค้าล็อกอินผ่านหน้าเว็บไม่ได้
# ใช้ค่าเดียวกับ backend ฝั่งลูกค้า (พอร์ต 4000) ถ้าไม่อยากให้ลูกค้าหลุดตอนสลับ
NEXTAUTH_SECRET=
# URL ที่เบราว์เซอร์เห็น (หน้าเว็บลูกค้า) — callback OAuth = {NEXTAUTH_URL}/api/auth/callback/{google,line}
NEXTAUTH_URL=http://localhost:3001
# URL หน้าเว็บลูกค้าในลิงก์อีเมล (ยืนยันอีเมล / ตั้งรหัสใหม่) · ไม่ตั้ง = ใช้ NEXTAUTH_URL
STOREFRONT_URL=

# ── CORS (frontend แยก origin — src/lib/cors.ts) ────────────
# comma-separated list ของ origin ที่อนุญาตให้ยิง API ข้าม origin มาได้ (คู่กับ credentials)
# ไม่ตั้ง/ว่าง = ปิดทั้งหมด (สมมติ same-origin เหมือนเดิม)
# backend เองใช้ port 3000 (default) → frontend ต้องรันคนละ port เช่น 3001
ALLOWED_ORIGINS=http://localhost:3001

# ── Cookie domain (production — src/lib/session.ts) ─────────
# ตั้งเมื่อ frontend กับ backend เป็น subdomain ของ site เดียวกัน เช่น app.meowmeecake.com ↔ api.meowmeecake.com
# → cookie ใช้ Domain=นี้ + SameSite=Lax + Secure (frontend เห็น cookie ได้ และไม่โดนบล็อกเป็น third-party cookie)
# ไม่ตั้ง (dev บน localhost) = host-only เหมือนเดิม · ถ้าคนละ site เลย (เช่น .com กับ .app) อย่าตั้งค่านี้
# ดู docs/security-hardening.md §3 "ตั้งค่าตอน deploy"
# COOKIE_DOMAIN=.meowmeecake.com

# ── Google login ──
# หลังร้าน: ID-token flow (POST /api/auth/google — ตรวจ signature JWKS + iss + aud + exp) ใช้แค่ CLIENT_ID
# หน้าเว็บลูกค้า: next-auth (code flow) ต้องมี CLIENT_SECRET ด้วย · ไม่ตั้ง SECRET = next-auth ไม่มีปุ่ม Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── อีเมล (ยืนยันอีเมล / reset password — src/lib/mailer.ts) ────────
# ไม่ตั้ง EMAIL_USER/EMAIL_PASS = สมัครสมาชิก/ลืมรหัสผ่านไม่ได้ (502) · Gmail ใช้ App Password
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
# SMTP เอง (แทน EMAIL_SERVICE) — ตั้ง EMAIL_HOST แล้วจะไม่ใช้ EMAIL_SERVICE · port 465 = TLS · ไม่ตั้ง port = 587
EMAIL_HOST=
EMAIL_PORT=

# ── ชำระเงิน ─────────────────────────────────────────────────
# เลขพร้อมเพย์สำหรับ QR หน้าชำระเงิน — ใช้เมื่อยังไม่ได้ตั้งในหลังร้าน (StoreProfile.promptpay_id) · ไม่ตั้งทั้งคู่ = ไม่มี QR
PROMPTPAY_ID=

# ── LINE Messaging API (แจ้งเตือน — src/lib/line.ts) ─────────
# token ของ Messaging API channel (LINE OA) — ใช้ส่งทั้งหาเจ้าของร้านและหาลูกค้า
LINE_CHANNEL_ACCESS_TOKEN=
# ปลายทางแจ้งเตือนฝั่งร้าน (userId/groupId ของเจ้าของร้าน)
LINE_TARGET_ID=
# true = ส่ง LINE หาเจ้าของร้านทุกออเดอร์หน้าร้าน (POS-) ด้วย · ไม่ตั้ง/อื่น ๆ = ออเดอร์ POS บันทึกในหน้าแจ้งเตือนเว็บอย่างเดียว
LINE_NOTIFY_POS_ORDERS=
# URL เว็บหลังร้าน (frontend) — ตั้งแล้วข้อความ LINE ถึงเจ้าของร้านจะแนบลิงก์ไปหน้าที่เกี่ยวข้อง (เช่นหน้าออเดอร์) · ไม่ตั้ง = ไม่แนบลิงก์
ADMIN_APP_URL=http://localhost:3001
# จำนวนข้อความ LINE ที่กันไว้ให้แจ้งเตือนเจ้าของร้านต่อเดือน — โควตาเหลือเท่านี้แล้วหยุดส่งหาลูกค้า (ค่าเริ่มต้น 30)
LINE_OWNER_QUOTA_RESERVE=

# ── LINE Login (ลูกค้าผูกบัญชี LINE เพื่อรับแจ้งเตือน — src/lib/lineLogin.ts) ──
# สร้าง LINE Login channel ใน Provider เดียวกับ Messaging API channel ด้านบน + ผูก OA ไว้ (Linked OA)
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# URL ของ backend ที่ LINE redirect กลับ — ต้องลงทะเบียนเป็น Callback URL ใน Console ตรงตัว
LINE_LOGIN_CALLBACK_URL=http://localhost:3000/api/shop/me/line/callback
# หน้า frontend ที่พากลับหลังผูกเสร็จ (แนบ ?line=linked|cancelled|error)
LINE_LINK_RETURN_URL=http://localhost:3001/profile

# ── งานตั้งเวลา (cron) — src/lib/cronAuth.ts ──────────────────
# secret สำหรับ /api/cron/* (ตัวตั้งเวลาต้องส่ง Authorization: Bearer <ค่านี้>) · ไม่ตั้ง = ปิด endpoint
# สร้างค่าสุ่มยาว ๆ เช่น: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
# เตือนลูกค้าก่อนวันรับพรีออเดอร์กี่วัน (0 = เช้าวันรับ) — ไม่ตั้ง = 1
PREORDER_REMINDER_DAYS_BEFORE=
# ชั่วโมงที่ลูกค้าต้องชำระเงินหลังสั่งพรีออเดอร์ (ไม่เกินเวลาปิดรอบ) — เลยแล้วยกเลิกอัตโนมัติ · ไม่ตั้ง = 24
# (docs/preorder-round-flow.md §6 — ต้องตั้ง cron เรียก /api/cron/preorder-rounds หรือ npm run cron:preorder-rounds ทุก 15 นาที)
PREORDER_PAYMENT_DEADLINE_HOURS=

# ── ค่าปรับแต่ง (ไม่ตั้งก็ได้ — ค่าเริ่มต้นใน docs/env.md) ───────────
# ค่าส่ง fallback ของหลังร้าน/POS เมื่อยังไม่มีโซนใน /api/admin/delivery-zones (บาท) · ส่งฟรีเมื่อยอดถึง
DELIVERY_FEE_METRO=
DELIVERY_FEE_UPCOUNTRY=
DELIVERY_FREE_MIN=
# อายุ cache (ms) · 0 = ปิด (ใช้ตอนเทส)
DELIVERY_ZONE_CACHE_TTL_MS=
PERMISSION_CACHE_TTL_MS=
RECOMMENDATION_CACHE_TTL_MS=

# ── ที่เก็บไฟล์อัปโหลด (src/lib/upload.ts · docs/env.md) ──────────
# localDisk (ค่าเริ่มต้น — เขียน public/uploads/ · self-host + nginx /uploads/) หรือ s3 (จำเป็นถ้า deploy serverless)
UPLOAD_DRIVER=
# เฉพาะ UPLOAD_DRIVER=s3 (S3_PUBLIC_URL_BASE บังคับ · S3_ENDPOINT ใส่เมื่อใช้ R2/GCS)
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_PUBLIC_URL_BASE=
