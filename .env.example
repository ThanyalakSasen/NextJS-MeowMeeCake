# ─────────────────────────────────────────────────────────────
# .env.example — คัดลอกเป็น .env.local แล้วเติมค่าจริง
# ดู docs/AUTH_PLAN.md + docs/MOCKS.md
# ─────────────────────────────────────────────────────────────

# MongoDB — ถ้าไม่กำหนด = โหมด mock (dbConnect ข้าม, controller คืน fixture จาก src/mocks/)
MONGODB_URI=

# JWT / session  (D11: access token สั้น + sliding refresh + absolute cap)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=30m
JWT_COOKIE_EXPIRE=7
SESSION_ABSOLUTE_HOURS=8

# Omise (QR payment) — ว่างไว้ = mock (ดู MOCKS.md)
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=

# Email (reset password ฯลฯ) — ยังไม่ใช้ในรอบ 27 screen
EMAIL_SERVICE=
EMAIL_USER=
EMAIL_PASS=

# Google OAuth — นอกขอบเขตรอบนี้ (D5)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
